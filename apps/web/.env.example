# Copy to .env.local. Server-side only: no NEXT_PUBLIC_ prefix, so Next never
# puts these in a client bundle. The browser calls /api/r/*, and the route
# handler adds the key (src/lib/server/backend.ts).
REACHABLE_API_URL=http://localhost:8001
# The backend's API_KEY (or MCP_API_KEY) from the repo-root .env
REACHABLE_API_KEY=
