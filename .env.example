# Copy to .env (`cp .env.example .env`) and change the passwords.
# .env is gitignored; never commit it.

# FalkorDB (Redis protocol). Host-side values, used by the CLI and tests.
# Ports are offset from the defaults so this runs beside other local stacks.
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_BROWSER_PORT=3001
FALKORDB_PASSWORD=change-me-falkor

# Postgres mirror (baseline only; FalkorDB is the primary store).
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=reachable
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=reachable

API_PORT=8001

# MCP server (streamable HTTP). The key is REQUIRED for HTTP (>= 16 chars);
# generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_PORT=8002
MCP_API_KEY=change-me-to-a-long-random-key

# Data generation
SEED=42

# NVD CVE API 2.0 key (optional but strongly recommended).
# Free key: https://nvd.nist.gov/developers/request-an-api-key
# With a key the limit is 50 requests / 30s; without, 5 / 30s (much slower).
NVD_API_KEY=

# --- LLMs for the S4 agents (make triage). Both free tiers. ---
# Primary: Gemini Flash. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fallback 1: Groq. Key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional overrides (LiteLLM model ids):
# LLM_PRIMARY_MODEL=gemini/gemini-2.5-flash
# LLM_FALLBACK_MODEL=groq/llama-3.3-70b-versatile
# Fallback 2: a small PAID model, off unless BOTH are set (judging-week safety net):
# LLM_RESERVE_MODEL=
# LLM_RESERVE_API_KEY=
# Per-run caps (free-tier protection):
# AGENT_MAX_LLM_CALLS=30
# AGENT_MAX_TOOL_CALLS=45
