# Production secrets for deploy/docker-compose.prod.yml (S10).
# Copy to deploy/.env.prod on the VPS and fill in. .env.prod is gitignored and
# dockerignored; never commit it. Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Public edge (Caddy) ---
API_DOMAIN=reachable-api.devarv.dev
# (A Let's Encrypt email is optional: see the commented line in Caddyfile.)

# --- The API key. Required on every endpoint but /health and /.
# The SAME value goes into Vercel as REACHABLE_API_KEY (server-side env only).
REACHABLE_API_KEY=

# --- Datastores (never published; only the api container talks to them) ---
FALKORDB_PASSWORD=
POSTGRES_USER=reachable
POSTGRES_PASSWORD=
POSTGRES_DB=reachable

# --- LLM (live runs only; replay and the demo video need none) ---
# Needed once to populate the demo runs (~$0.05), then for live judge clicks.
# Keep ~$10 of Gemini credit so a live judge run never answers 402.
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=gemini/gemini-3.5-flash-lite
# Paid reserve model: OFF unless both are set. Leave empty unless the primary
# runs dry during judging; it is the last fallback, so expect little spend.
LLM_RESERVE_MODEL=
LLM_RESERVE_API_KEY=
# Rate limiter: at most this many model calls a minute (per run). Keep it on.
LLM_RPM=20
# Per-run caps, and at most this many agent runs at once (the next gets a 429).
AGENT_MAX_LLM_CALLS=20
AGENT_MAX_TOOL_CALLS=45
API_MAX_RUNS=2
